# 前台始终免密码；PASSWORD 仅为旧版兼容变量
# PASSWORD=

# 管理后台独立密钥：使用 openssl rand -hex 32 生成，填写到服务器环境变量
ADMIN_KEY=

# 旧版兼容字段；当前前台始终免密码
# AUTH_DISABLED=true

# 全站配置存储目录（默认 ./data；Docker 默认 /app/data，须持久化）
# DATA_DIR=

# 资源目录：持续运行的生产 Node 服务每四天北京时间 05:00 自动刷新
# 设置为 0 可关闭；开发模式不启动。刷新结果保存在 DATA_DIR/source-presets.json
# CATALOG_AUTO_SYNC=1

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 可选：项目内 Node drpyS 引擎。先 npm run drpy:install，再 npm run drpy:start。
# 主站和引擎使用同一 DRPY_API_KEY；不写入源列表或分享链接。
DRPY_ENABLED=0
DRPY_BASE_URL=http://127.0.0.1:5757
DRPY_API_KEY=
DRPY_MODULES=cctv-public
# 本机当前 Node 24 时，引擎单独使用 Node 22 可执行文件；Docker 已固定 Node 22。
# DRPY_NODE_BIN=/absolute/path/to/node22
# DRPY_HOST=127.0.0.1
# DRPY_PORT=5757

# Docker：仅使用本仓库发布的镜像。生产可指定 sha-<完整提交SHA> 或 @sha256:<摘要>。
LIBRETV_IMAGE=ghcr.io/maolikeqvq/mqtv:latest
DRPY_IMAGE=ghcr.io/maolikeqvq/mqtv-drpy:latest
HOST_BIND=0.0.0.0
# 服务器端口（容器内部仍为 8080），避免占用服务器的 8080。
HOST_PORT=18080
# 新部署使用此卷名；迁移已有部署请填写原来的实际 Docker 卷名。
MQTV_DATA_VOLUME=mqtv-data
# 启用 drpy 时同时设置 DRPY_ENABLED=1、非空 DRPY_API_KEY 和以下 profile。
# COMPOSE_PROFILES=drpy

# 当前源码一键部署：bash scripts/deploy-docker.sh [服务器端口]
# 首次运行自动生成 .env 和密钥，默认开启 drpy；已有配置原样复用。
