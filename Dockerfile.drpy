FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache curl
COPY scripts/install-drpy.mjs ./scripts/install-drpy.mjs
RUN node scripts/install-drpy.mjs
COPY services/drpy ./services/drpy
COPY LICENSE ./LICENSE
RUN chown -R node:node /app/.runtime
USER node
ENV NODE_ENV=production
ENV DRPY_HOST=0.0.0.0
EXPOSE 5757
CMD ["node", "services/drpy/server.mjs"]
